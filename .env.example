# Copiar a .env para cambiar puertos o tópicos. Sin secretos: todo corre local.
REDPANDA_KAFKA_PORT=19092
CONSOLE_PORT=8080
COLLECTOR_PORT=8000
TOPIC=backrooms.eventos
DLQ_TOPIC=backrooms.eventos.dlq
# Grupo del consumer de F3: cambiarlo hace que relea los tópicos desde el principio.
CONSUMER_GROUP=backrooms-consumer
# El proxy de Vite (npm run dev) manda /api/* acá.
COLLECTOR_URL=http://localhost:8000
